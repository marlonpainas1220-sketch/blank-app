# Copy to .env and fill with your keys. Never commit .env
# Optional API keys for generation (mocked if empty)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# NextAuth (JWT-based default)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Database
DATABASE_URL=file:./dev.db

# Multi-tenant config
APP_BASE_URL=http://localhost:3000
